stage('Create ALB Listener Rule') {
    when {
     expression { return env.DEPLOYMENT_TYPE != 'Worker' }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: env.AWS_CREDENTIALS_ID]]) {
          script {
            def hostFqdn = "${env.DEPLOYMENT_NAME}.${env.BASE_DOMAIN}".toLowerCase()
            env.HOST_FQDN = hostFqdn
            sh """#!/usr/bin/env bash
set -euo pipefail
export AWS_REGION=${env.AWS_REGION}
export AWS_DEFAULT_REGION=${env.AWS_REGION}
ALB_ARN='${env.ALB_ARN}'
TG_ARN='${env.TG_ARN}'
HOST_FQDN='${hostFqdn}'
echo "Finding HTTPS listener..."
LISTENER_JSON=\$(aws elbv2 describe-listeners --load-balancer-arn "\$ALB_ARN" --output json)
LISTENER_ARN=\$(python3 - "\$LISTENER_JSON" <<'PY'
import json, sys
raw = sys.argv[1] if len(sys.argv) > 1 else ""
data = json.loads(raw)
listeners = data.get("Listeners", [])
def pick(port):
    for l in listeners:
        if l.get("Port") == port:
            return l.get("ListenerArn")
    return None
arn = pick(443) or pick(80) or (listeners[0].get("ListenerArn") if listeners else "")
print(arn or "")
PY
)
if [ -z "\$LISTENER_ARN" ]; then
  echo "No listener found"
  exit 1
fi
echo "Listener: \$LISTENER_ARN"
echo "Checking for existing host rule..."
EXISTING_RULE_ARN=\$(aws elbv2 describe-rules --listener-arn "\$LISTENER_ARN" \\
  --query "Rules[?Conditions[?Field=='host-header' && Values[0]=='\$HOST_FQDN']].RuleArn | [0]" \\
  --output text 2>/dev/null || true)
if [ -n "\$EXISTING_RULE_ARN" ] && [ "\$EXISTING_RULE_ARN" != "None" ]; then
  echo "Updating rule: \$EXISTING_RULE_ARN"
  aws elbv2 modify-rule --rule-arn "\$EXISTING_RULE_ARN" \\
    --conditions Field=host-header,Values="\$HOST_FQDN" \\
    --actions Type=forward,TargetGroupArn="\$TG_ARN" >/dev/null
  RULE_ARN_TO_TAG="\$EXISTING_RULE_ARN"
else
  echo "Creating new rule..."
  PRIORITY=200
  while aws elbv2 describe-rules --listener-arn "\$LISTENER_ARN" \\
    --query "Rules[?Priority=='\$PRIORITY']" --output text | grep -q .; do
    PRIORITY=\$((PRIORITY+1))
  done
  RULE_ARN_TO_TAG=\$(aws elbv2 create-rule \\
    --listener-arn "\$LISTENER_ARN" \\
    --priority "\$PRIORITY" \\
    --conditions Field=host-header,Values="\$HOST_FQDN" \\
    --actions Type=forward,TargetGroupArn="\$TG_ARN" \\
    --query 'Rules[0].RuleArn' --output text)
fi
aws elbv2 add-tags --resource-arns "\$RULE_ARN_TO_TAG" \\
  --tags Key=costCenter,Value=${env.COST_CENTER_TAG} Key=DeploymentName,Value=${env.DEPLOYMENT_NAME} || true
echo "Listener rule created/updated for \$HOST_FQDN"
"""
          }
        }
      }
    }

