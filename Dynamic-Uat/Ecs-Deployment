   stage('Wait for Service Stability') {
  steps {
    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: env.AWS_CREDENTIALS_ID]]) {

      script {
        if (env.DEPLOYMENT_TYPE == 'Worker') {
          echo "Worker mode → skipping ALB target health wait"
          sh """#!/bin/bash
            aws ecs wait services-stable \
              --cluster ${env.ECS_CLUSTER_NAME} \
              --services ${env.ECS_SERVICE_NAME} \
              --region ${env.AWS_REGION}
          """
        } else {

          sh """#!/bin/bash
            aws ecs wait services-stable \
              --cluster ${env.ECS_CLUSTER_NAME} \
              --services ${env.ECS_SERVICE_NAME} \
              --region ${env.AWS_REGION}
          """

        }
      }
    }
  }
}

    stage('Create Route53 DNS + Health Check') {
    when {
      expression { return env.DEPLOYMENT_TYPE != 'Worker' }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: env.AWS_CREDENTIALS_ID]]) {
          script {
            sh """#!/usr/bin/env bash
set -euo pipefail
export AWS_REGION=${env.AWS_REGION}
export AWS_DEFAULT_REGION=${env.AWS_REGION}

ALB_ARN='${env.ALB_ARN}'
TG_ARN='${env.TG_ARN}'
HOST_FQDN='${env.HOST_FQDN}'
PUBLIC_HOSTED_ZONE_ID='${env.PUBLIC_HOSTED_ZONE_ID}'

echo "Discovering ALB details..."
LB_DESC=\$(aws elbv2 describe-load-balancers --load-balancer-arns "\$ALB_ARN" --output json)
ALB_DNS=\$(echo "\$LB_DESC" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["LoadBalancers"][0]["DNSName"])')
ALB_ZONE_ID=\$(echo "\$LB_DESC" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["LoadBalancers"][0]["CanonicalHostedZoneId"])')

echo "ALB_DNS: \$ALB_DNS"

echo "Creating Route53 alias record..."
TMPFILE=\$(mktemp)
cat > "\$TMPFILE" <<EOF
{
  "Comment": "UPSERT alias for \$HOST_FQDN",
  "Changes": [
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "\$HOST_FQDN.",
        "Type": "A",
        "AliasTarget": {
          "HostedZoneId": "\$ALB_ZONE_ID",
          "DNSName": "\$ALB_DNS",
          "EvaluateTargetHealth": false
        }
      }
    }
  ]
}
EOF
aws route53 change-resource-record-sets \\
  --hosted-zone-id "\$PUBLIC_HOSTED_ZONE_ID" \\
  --change-batch "file://\$TMPFILE"
rm -f "\$TMPFILE"

echo "Waiting for target health..."
for i in {1..30}; do
  STATE=\$(aws elbv2 describe-target-health --target-group-arn "\$TG_ARN" \\
    --query 'TargetHealthDescriptions[0].TargetHealth.State' --output text 2>/dev/null || true)
  echo "Health check \$i: \$STATE"
  if [ "\$STATE" = "healthy" ]; then
    echo "Target is healthy"
    break
  fi
  sleep 10
done

echo "HTTPS URL: https://\$HOST_FQDN/"
"""
          }
        }
      }
    }

    stage('Schedule Auto-Delete (optional)') {
      when { expression { params.AUTO_DELETE == 'true' } }
      steps {
        script {
          def ttl = params.AUTO_DELETE_HOURS ?: '24'
          writeFile file: 'delete-resources.sh', text: """
#!/bin/bash
set -euo pipefail
export AWS_REGION=${env.AWS_REGION}
export AWS_DEFAULT_REGION=${env.AWS_REGION}

ECS_CLUSTER="${env.ECS_CLUSTER_NAME}"
ECS_SERVICE="${env.ECS_SERVICE_NAME}"
TG_ARN="${env.TG_ARN}"
LOG_GROUP="${env.LOG_GROUP_NAME}"
HOST_FQDN="${env.HOST_FQDN ?: ''}"
ECR_REPO="${env.ECR_REPO_NAME}"
DEPLOYMENT_NAME="${env.DEPLOYMENT_NAME}"

echo "Deleting ECS service..."
aws ecs update-service --cluster \$ECS_CLUSTER --service \$ECS_SERVICE --desired-count 0 --region \$AWS_REGION || true
sleep 30
aws ecs delete-service --cluster \$ECS_CLUSTER --service \$ECS_SERVICE --force --region \$AWS_REGION || true

echo "Waiting for service deletion..."
aws ecs wait services-inactive --cluster \$ECS_CLUSTER --services \$ECS_SERVICE --region \$AWS_REGION || true

echo "Deleting ECS cluster..."
aws ecs delete-cluster --cluster \$ECS_CLUSTER --region \$AWS_REGION || true

echo "Deleting target group..."
aws elbv2 delete-target-group --target-group-arn \$TG_ARN --region \$AWS_REGION || true

echo "Deleting CloudWatch log group..."
aws logs delete-log-group --log-group-name \$LOG_GROUP --region \$AWS_REGION || true

echo "Deleting ECR repository..."
aws ecr delete-repository --repository-name \$ECR_REPO --force --region \$AWS_REGION || true

echo "ECS resources deleted successfully"
"""
          archiveArtifacts artifacts: 'delete-resources.sh'
          echo "Auto-delete script archived. Run manually or set up Lambda/EventBridge for TTL."
        }
      }
    }

    stage('Save Deployment Info') {
      steps {
        script {
          def info = """
DEPLOYMENT_NAME=${env.DEPLOYMENT_NAME}
ECS_CLUSTER_NAME=${env.ECS_CLUSTER_NAME}
ECS_SERVICE_NAME=${env.ECS_SERVICE_NAME}
TASK_DEF_ARN=${env.TASK_DEF_ARN}
TG_ARN=${env.TG_ARN}
TG_NAME=${env.TG_NAME}
ECR_REPO_URI=${env.ECR_REPO_URI}
LOG_GROUP_NAME=${env.LOG_GROUP_NAME}
HOST_FQDN=${env.HOST_FQDN ?: ''}
IMAGE_TAG=${env.IMAGE_TAG}
BITBUCKET_REPO=${env.SELECTED_BITBUCKET_REPO ?: ''}
BITBUCKET_BRANCH=${env.SELECTED_BITBUCKET_BRANCH ?: ''}
"""
          writeFile file: '.ecs_deployment_info', text: info
          archiveArtifacts artifacts: '.ecs_deployment_info'
        }
      }
    }
  }

  post {
    success {
      script {
        echo """
========================================
ECS DEPLOYMENT SUCCESSFUL
========================================
Deployment Name  : ${env.DEPLOYMENT_NAME}
ECS Cluster      : ${env.ECS_CLUSTER_NAME}
ECS Service      : ${env.ECS_SERVICE_NAME}
Target Group     : ${env.TG_NAME}
ECR Repository   : ${env.ECR_REPO_URI}
Task Definition  : ${env.TASK_DEF_ARN}
Please use this Keyword for view your Grafana Logs :  CMB-Dynamic-UAT-${env.DEPLOYMENT_NAME}
Access URL : ${env.DEPLOYMENT_TYPE == 'Worker' ? 'N/A (Worker Service)' : "https://${env.HOST_FQDN}/"}
========================================
"""
      }
    }
    failure {
      echo "ECS Deployment failed"
    }
  }
}
