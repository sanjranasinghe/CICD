def repoChoiceScript = '''
import com.cloudbees.plugins.credentials.CredentialsProvider
import com.cloudbees.plugins.credentials.common.StandardUsernamePasswordCredentials
import groovy.json.JsonSlurperClassic
import jenkins.model.Jenkins
import java.util.Base64
def workspace = 'moresand'
def credentialId = 'thilak-api'
try {
  def creds = CredentialsProvider.lookupCredentials(
    StandardUsernamePasswordCredentials.class,
    Jenkins.get(),
    null,
    null
  ).find { it.id == credentialId }
  if (!creds) {
    return ['NO_BITBUCKET_CREDENTIAL']
  }
  def username = creds.username
  def password = creds.password.getPlainText()
  def auth = Base64.encoder.encodeToString("${username}:${password}".getBytes('UTF-8'))
  def repos = []
  def nextUrl = "https://api.bitbucket.org/2.0/repositories/${workspace}?pagelen=100"
  while (nextUrl != null && nextUrl.toString().trim()) {
    def conn = new URL(nextUrl).openConnection()
    conn.setRequestProperty('Authorization', "Basic ${auth}")
    conn.setRequestProperty('Accept', 'application/json')
    conn.setConnectTimeout(15000)
    conn.setReadTimeout(15000)
    def code = conn.getResponseCode()
    if (code != 200) {
      return ["API_ERROR_${code}".toString()]
    }
    def payload = new JsonSlurperClassic().parseText(
      conn.getInputStream().getText('UTF-8')
    )
    def values = payload['values'] ?: []
    values.each { repo ->
      def repoName = repo['name']
      if (repoName) {
        repos << repoName.toString()
      }
    }
    nextUrl = payload['next'] ? payload['next'].toString() : null
  }
  def choices = repos
    .findAll { it != null && it.toString().trim() }
    .unique()
    .sort(false) { a, b -> a.toLowerCase() <=> b.toLowerCase() }
  def searchTerm = (REPO_SEARCH ?: '').toString().trim().toLowerCase()
  if (!searchTerm) {
    return ['Type at least 3 letters in REPO_SEARCH']
  }
  if (searchTerm.length() < 3) {
    return ['Type at least 3 letters in REPO_SEARCH']
  }
  def filteredChoices = choices.findAll { it.toLowerCase().contains(searchTerm) }
  return filteredChoices ? (['-- Select repository --'] + filteredChoices) : ['NO_MATCHING_REPOSITORIES']
} catch (Throwable e) {
  return ["ERROR_${e.class.simpleName}: ${e.message}".toString()]
}
'''
def branchChoiceScript = '''
def repoName = Bitbucket_Repo_URI?.toString()?.trim()
if (!repoName || repoName == '-- Select repository --' || repoName.startsWith('NO_') || repoName.startsWith('API_ERROR_') || repoName.startsWith('ERROR_')) {
  return ['main']
}
def sshUrl = "git@bitbucket.org:moresand/${repoName}.git"
def proc = ['bash', '-lc', "git ls-remote --heads '${sshUrl}'"].execute()
def out = new StringBuffer()
def err = new StringBuffer()
proc.consumeProcessOutput(out, err)
proc.waitForOrKill(15000)
if (proc.exitValue() != 0 || !out) {
  return ['main']
}
def branches = out.toString().readLines()
  .collect { it.tokenize()[1]?.replace('refs/heads/', '') }
  .findAll { it }
  .unique()
  .sort(false) { a, b -> a.toLowerCase() <=> b.toLowerCase() }
return branches ?: ['main']
'''


