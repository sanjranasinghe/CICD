import groovy.json.JsonOutput

def mergeEnvironmentVariables(List baseVars, String overridesText) {
  def merged = new LinkedHashMap<String, String>()

  (baseVars ?: []).each { entry ->
    if (entry?.name != null) {
      merged[entry.name.toString()] = entry.value == null ? '' : entry.value.toString()
    }
  }

  overridesText?.readLines()?.eachWithIndex { rawLine, index ->
    def line = (rawLine ?: '').trim()
    if (!line || line.startsWith('#')) {
      return
    }

    if (line.startsWith('!')) {
      def keyToRemove = line.substring(1).trim()
      if (!keyToRemove) {
        throw new IllegalArgumentException("Environment_Variables line ${index + 1} has an invalid remove instruction.")
      }
      merged.remove(keyToRemove)
      return
    }

    int separatorIndex = line.indexOf('=')
    if (separatorIndex <= 0) {
      throw new IllegalArgumentException("Environment_Variables line ${index + 1} must use KEY=VALUE format.")
    }

    def key = line.substring(0, separatorIndex).trim()
    def value = line.substring(separatorIndex + 1)
    if (!(key ==~ /^[A-Za-z_][A-Za-z0-9_]*$/)) {
      throw new IllegalArgumentException("Environment variable '${key}' on line ${index + 1} is invalid.")
    }

    merged[key] = value
  }

  return merged.collect { key, value -> [name: key, value: value] }
}

