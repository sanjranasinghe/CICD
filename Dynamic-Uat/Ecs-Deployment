        ).trim()

        env.TASK_DEF_ARN = taskDefArn
        echo "Task Definition: ${env.TASK_DEF_ARN}"
      }
    }
  }
}

stage('Create ECS Service') {
  steps {
    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: env.AWS_CREDENTIALS_ID]]) {
      script {
        def isWorker = (env.DEPLOYMENT_TYPE == 'Worker')
        // ==================================================
        // CHECK IF SERVICE EXISTS
        // ==================================================
        def serviceExists = sh(script: """
          aws ecs describe-services \
            --cluster ${env.ECS_CLUSTER_NAME} \
            --services ${env.ECS_SERVICE_NAME} \
            --region ${env.AWS_REGION} \
            --query 'services[0].status' \
            --output text 2>/dev/null || echo ""
        """, returnStdout: true).trim()
        if (serviceExists && serviceExists != 'INACTIVE' && serviceExists != 'None' && serviceExists != 'NoneType') {
          echo "Service already exists: ${env.ECS_SERVICE_NAME}"
          error("Pipeline stopped: ECS service already exists. No updates allowed.")
        }
        // ==================================================
        // CREATE NEW SERVICE ONLY
        // Note: --enable-ecs-managed-tags + --propagate-tags SERVICE
        // ensures the Fargate tasks/ENIs launched by this service
        // inherit the costCenter tag for cost-allocation reporting.
        // ==================================================
        echo "Creating NEW ECS service (no updates allowed)..."
        if (isWorker) {
          echo "Worker mode -> creating ECS service WITHOUT ALB"
          sh """#!/bin/bash
aws ecs create-service \
  --cluster ${env.ECS_CLUSTER_NAME} \
  --service-name ${env.ECS_SERVICE_NAME} \
  --task-definition ${env.TASK_DEF_ARN} \
  --desired-count ${env.DESIRED_COUNT} \
  --capacity-provider-strategy capacityProvider=FARGATE,weight=1,base=1 capacityProvider=FARGATE_SPOT,weight=1 \
  --network-configuration "awsvpcConfiguration={subnets=[${env.SUBNET_LIST}],securityGroups=[${env.SG_ID}],assignPublicIp=ENABLED}" \
  --enable-ecs-managed-tags \
  --propagate-tags SERVICE \
  --region ${env.AWS_REGION}
"""
        } else {
          echo "Web/API mode -> creating ECS service WITH ALB"
          sh """#!/bin/bash
aws ecs create-service \
  --cluster ${env.ECS_CLUSTER_NAME} \
  --service-name ${env.ECS_SERVICE_NAME} \
  --task-definition ${env.TASK_DEF_ARN} \
  --desired-count ${env.DESIRED_COUNT} \
  --capacity-provider-strategy capacityProvider=FARGATE,weight=1,base=1 capacityProvider=FARGATE_SPOT,weight=1 \
  --network-configuration "awsvpcConfiguration={subnets=[${env.SUBNET_LIST}],securityGroups=[${env.SG_ID}],assignPublicIp=ENABLED}" \
  --load-balancers "targetGroupArn=${env.TG_ARN},containerName=${env.DEPLOYMENT_NAME},containerPort=${env.DEPLOYMENT_PORT}" \
  --enable-ecs-managed-tags \
  --propagate-tags SERVICE \
  --region ${env.AWS_REGION}
"""
        }
        // ==================================================
        // TAG SERVICE (ONLY AFTER CREATION)
        // ==================================================
        sh """#!/bin/bash
set -euo pipefail
SERVICE_ARN=\$(aws ecs describe-services \
  --cluster ${env.ECS_CLUSTER_NAME} \
  --services ${env.ECS_SERVICE_NAME} \
  --region ${env.AWS_REGION} \
  --query 'services[0].serviceArn' \
  --output text)
aws ecs tag-resource \
  --resource-arn "\$SERVICE_ARN" \
  --tags \
    key=DeploymentName,value=${env.DEPLOYMENT_NAME} \
    key=ENV,value=${env.TAG_NAME} \
    key=BitbucketRepo,value=${env.SELECTED_BITBUCKET_REPO} \
    key=BitbucketBranch,value=${env.SELECTED_BITBUCKET_BRANCH} \
    key=LaunchedBy,value=${getJenkinsUsername()} \
    key=LaunchDate,value=${env.LAUNCH_DATE} \
    key=DeploymentType,value=${env.DEPLOYMENT_TYPE} \
    key=costCenter,value=${env.COST_CENTER_TAG} \
  --region ${env.AWS_REGION}
"""
      }
    }
  }
}

